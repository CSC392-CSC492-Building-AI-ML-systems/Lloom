# Copy this file to `.env` in the same folder and fill in your values.
# `.env` is ignored by git, so your keys stay on your machine. Never commit it.
# After editing `.env`, restart your notebook kernel / Python process.

# --- Option 1: OpenAI (default) ---
OPENAI_API_KEY=

# --- Option 2: any OpenAI-compatible API (Gemini, Ollama, ...) ---
# When LLM_BASE_URL is set, these settings are used and OPENAI_API_KEY is ignored.
# Leave LLM_BASE_URL blank to use OpenAI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_EMBED_MODEL=

# Needed only for models LLooM does not know about (it never guesses them).
# Models in LLooM's list (ex: gpt-4o-mini) do not need these.
#   LLM_CONTEXT_WINDOW: tokens, a whole number
#   LLM_COST / LLM_EMBED_COST: "input_cost,output_cost" per token, for the chat / embedding model
#   LLM_RATE_LIMIT: "n_requests,wait_time_secs" (LLooM sends n requests, then waits)
# LLM_CONTEXT_WINDOW=8192
# LLM_COST=0,0
# LLM_EMBED_COST=0,0
# LLM_RATE_LIMIT=1000,0

# --- Example: Ollama (local, free) ---
# Run `ollama pull llama3.1:8b` and `ollama pull nomic-embed-text` first. Ollama may cut off long
# prompts silently, so set OLLAMA_CONTEXT_LENGTH to the same value as LLM_CONTEXT_WINDOW.
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# LLM_EMBED_MODEL=nomic-embed-text
# LLM_CONTEXT_WINDOW=8192
# LLM_COST=0,0
# LLM_EMBED_COST=0,0
# LLM_RATE_LIMIT=1000,0

# --- Example: Gemini ---
# Model names and free-tier limits change often: check Google AI Studio for the current ones.
# Set LLM_RATE_LIMIT below your quota, or requests fail with 429 errors.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=<a current Gemini chat model>
# LLM_EMBED_MODEL=<a current Gemini embedding model>
# LLM_CONTEXT_WINDOW=<the model's context window>
# LLM_COST=0,0
# LLM_EMBED_COST=0,0
# LLM_RATE_LIMIT=10,60
